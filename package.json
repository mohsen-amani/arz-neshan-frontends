{
  "name": "arz-neshan-frontends",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start:public": "ng serve public --port 4100 --proxy-config projects/shared/proxy.conf.json",
    "start:workspace": "ng serve workspace --port 4200 --proxy-config projects/shared/proxy.conf.json",
    "start:platform": "ng serve platform --port 4400 --proxy-config projects/shared/proxy.conf.json",
    "build": "ng build public && ng build workspace && ng build platform",
    "build:public": "ng build public",
    "build:workspace": "ng build workspace",
    "build:platform": "ng build platform",
    "test": "ng test public --watch=false && ng test workspace --watch=false && ng test platform --watch=false",
    "format": "prettier --write \"projects/**/*.{ts,html,css,json}\" \"*.{json,mjs}\""
  },
  "dependencies": {
    "@angular/cdk": "^21.0.1",
    "@angular/common": "^21.0.1",
    "@angular/compiler": "^21.0.1",
    "@angular/core": "^21.0.1",
    "@angular/forms": "^21.0.1",
    "@angular/platform-browser": "^21.0.1",
    "@angular/platform-server": "^21.0.1",
    "@angular/router": "^21.0.1",
    "@angular/ssr": "^21.0.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "angular-tabler-icons": "^3.26.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.1",
    "@angular/cli": "^21.0.1",
    "@angular/compiler-cli": "^21.0.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "packageManager": "yarn@4.16.0"
}
